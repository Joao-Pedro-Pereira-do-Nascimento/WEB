# Copie este arquivo para .streamlit/secrets.toml (NUNCA faça commit dele!)
# ou cole o conteúdo em "Settings > Secrets" no Streamlit Community Cloud.
#
# Como o app escolhe onde guardar os dados:
#   - seção [firebase] COM database_url  -> Firebase Realtime Database (recomendado)
#   - seção [firebase] SEM database_url  -> Cloud Firestore
#   - sem a seção [firebase]             -> arquivos locais em .data/
#
# Os demais valores vêm do JSON da conta de serviço do Firebase
# (Console do Firebase > Configurações do projeto > Contas de serviço >
#  "Gerar nova chave privada"). Copie campo por campo.

[firebase]
database_url = "https://baralhoflocloriobr-default-rtdb.firebaseio.com"
type = "service_account"
project_id = "baralhoflocloriobr"
private_key_id = "abc123..."
private_key = "-----BEGIN PRIVATE KEY-----\nCOLE_AQUI_A_CHAVE_INTEIRA\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@baralhoflocloriobr.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40baralhoflocloriobr.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# ---------------------------------------------------------------------------
# Login com Google (opcional). Sem esta seção o botão "Entrar com Google" fica
# desativado e o resto do app funciona normalmente. Passo a passo no README.
#   - redirect_uri: http://localhost:8501/oauth2callback (no computador) ou
#     https://SEU-APP.streamlit.app/oauth2callback (no Streamlit Cloud);
#     o mesmo endereço precisa estar em "URIs de redirecionamento autorizados"
#     do cliente OAuth no Google Cloud Console.
#   - cookie_secret: texto aleatório longo, por exemplo o resultado de
#     python -c "import secrets; print(secrets.token_hex(32))"
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "TROQUE-POR-UM-SEGREDO-ALEATORIO"

[auth.google]
client_id = "123456789012-xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
